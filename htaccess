<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/webm .webm
</IfModule>

# Block direct access to sensitive file types
<FilesMatch "\.(sql|xml|json|lock|frm|ibd|opt|env|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files and directories directly (CSS, JS, images, admin, AJAX endpoints)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Live SEO-friendly clean URLs -> Backend PHP files
    RewriteRule ^about-us/?$ about.php [L,QSA]
    RewriteRule ^our-services/?$ services.php [L,QSA]
    RewriteRule ^our-services/seo-company-in-kerala/?$ seo.php [L,QSA]
    RewriteRule ^our-services/ai-seo-services-in-kerala/?$ ai-seo.php [L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*/)ai-seo-services-in-kerala/?$
    RewriteRule ^ %1our-services/ai-seo-services-in-kerala/ [R=301,L]
    RewriteRule ^our-services/social-media-management-company-in-kerala/?$ smm.php [L,QSA]
    RewriteRule ^our-services/website-development-company-in-kerala/?$ website-development.php [L,QSA]
    RewriteRule ^our-services/best-lead-generation-company-in-kerala/?$ lead-generation.php [L,QSA]
    RewriteRule ^our-services/online-advertising-agency-in-kerala/?$ online-advertising.php [L,QSA]
    RewriteRule ^real-estate-marketing-agency-kerala/?$ construction.php [L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*/)construction-marketing-agency-kerala/?$
    RewriteRule ^ %1real-estate-marketing-agency-kerala/ [R=301,L]
    RewriteRule ^digital-marketing-trivandrum-guide/?$ digital-marketing-trivandrum-guide.php [L,QSA]
    RewriteRule ^digital-marketing-agency-in-kochi/?$ digital-marketing-agency-in-kochi.php [L,QSA]
    RewriteRule ^seo-course-in-kerala/?$ seo-course-in-kerala.php [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]

    # Additional site pages for uniform clean URLs
    RewriteRule ^portfolio/?$ portfolio.php [L,QSA]
    RewriteRule ^careers/?$ careers.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^terms-and-conditions/?$ terms-and-conditions.php [L,QSA]

    # Admin panel clean slugs -> Admin PHP files
    RewriteRule ^admin/dashboard/?$ admin/index.php [L,QSA]
    RewriteRule ^admin/login/?$ admin/login.php [L,QSA]
    RewriteRule ^admin/logout/?$ admin/logout.php [L,QSA]
    RewriteRule ^admin/enquiries/?$ admin/resources/contact_messages.php [L,QSA]
    RewriteRule ^admin/blog/?$ admin/resources/blog_posts.php [L,QSA]
    RewriteRule ^admin/blog/editor/?$ admin/resources/blog_editor.php [L,QSA]
    RewriteRule ^admin/services/?$ admin/resources/services.php [L,QSA]
    RewriteRule ^admin/testimonials/?$ admin/resources/testimonials.php [L,QSA]
    RewriteRule ^admin/faqs/?$ admin/resources/faqs.php [L,QSA]
    RewriteRule ^admin/users/?$ admin/resources/users.php [L,QSA]

    # Dynamic service slugs edited from Admin CMS
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteRule ^(.+?)/?$ service-router.php?route=$1 [L,QSA]
</IfModule>
